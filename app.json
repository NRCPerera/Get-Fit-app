{
  "expo": {
    "name": "Get Fit",
    "slug": "gym-management-app",
    "version": "2.0.1",
    "orientation": "default",
    "icon": "./assets/icon-square.png",
    "userInterfaceStyle": "light",
    "scheme": "getfit",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ridma2001.getfit",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Get Fit needs access to your camera to allow you to take profile pictures or scan gym equipment.",
        "NSPhotoLibraryUsageDescription": "Get Fit needs access to your photos to let you upload a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.getfit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-square.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Get Fit to access your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Get Fit to access your photos."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-square.png",
          "color": "#6366f1",
          "sounds": []
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-square.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "90a966f6-cf24-4333-831a-c48108ee0a91"
      }
    },
    "owner": "ridma2001"
  }
}
